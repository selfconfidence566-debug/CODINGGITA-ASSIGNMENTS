### Question 41
**ANSWER**

<form action="/apply.php"
      method="post"
      enctype="multipart/form-data">

    <fieldset>

        <legend>Personal Details</legend>

        <label for="name">Name:</label>
        <input type="text"
               id="name"
               name="name"
               required>

        <label for="email">Email:</label>
        <input type="email"
               id="email"
               name="email"
               required>

        <label for="phone">Phone:</label>
        <input type="tel"
               id="phone"
               name="phone"
               required>

    </fieldset>

    <fieldset>

        <legend>Experience</legend>

        <label for="experience">Experience:</label>

        <textarea id="experience"
                  name="experience"
                  rows="5"
                  cols="50"></textarea>

    </fieldset>

    <label for="resume">Resume:</label>

    <input type="file"
           id="resume"
           name="resume"
           accept=".pdf"
           required>

    <p>Employment Type:</p>

    <input type="radio"
           id="fulltime"
           name="employment"
           value="fulltime">

    <label for="fulltime">Full Time</label>

    <input type="radio"
           id="parttime"
           name="employment"
           value="parttime">

    <label for="parttime">Part Time</label>

    <br>

    <input type="checkbox"
           id="terms"
           name="terms"
           value="accepted"
           required>

    <label for="terms">
        I agree to the terms and conditions
    </label>

    <br>

    <button type="submit">Submit Application</button>

    <button type="submit" formnovalidate>
        Save Draft
    </button>

</form>


### Question 42
**ANSWER**

<form action="/default.php"
      method="post"
      target="_self">

    <label for="name">Name:</label>

    <input type="text"
           id="name"
           name="name"
           required>

    <label for="email">Email:</label>

    <input type="email"
           id="email"
           name="email"
           required>

    <button type="submit"
            formaction="/save.php">
        Use formaction
    </button>

    <button type="submit"
            formmethod="get">
        Use formmethod
    </button>

    <button type="submit"
            formnovalidate>
        Use formnovalidate
    </button>

    <button type="submit"
            formtarget="_blank">
        Use formtarget
    </button>

</form>
